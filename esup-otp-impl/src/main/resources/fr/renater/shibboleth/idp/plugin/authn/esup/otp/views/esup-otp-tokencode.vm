##
## Velocity Template for DisplayTOTPView view-state
##
#set ($esupOtpContext = $authenticationContext.getSubcontext('fr.renater.shibboleth.idp.plugin.authn.esup.otp.context.EsupOtpContext'))
#set ($uid = $esupOtpContext.getUsername())
#set ($apiUrl = $environment.getProperty("idp.esup.otp.apiHost"))
<!DOCTYPE html>
<html>
    <head>
        <title>#springMessageText("idp.title", "Web Login Service")</title>
        #parse("head.vm")
        <link href="${apiUrl}/public/login.css" rel="stylesheet" />
        <script src="$request.getContextPath()/js/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="></script>
        <script src="${apiUrl}/js/socket.io.js"></script>
        <script src="${apiUrl}/public/login.js"></script>
        <style>
        body {
            max-width: 800px;
            margin: 0 auto;
            font-family: Arial,"Helvetica Neue", Helvetica,verdana, sans-serif;
        }
        h1 {
            text-align: center;
        }
        #errors {
            color: #CF4A02;
        }
        </style>
    </head>
    <body>
        <main class="main">
            <section class="small-12 small-centered medium-8 large-7">
                #parse("header.vm")
                <h1>#springMessageText("idp.esup.otp.title", "Multi-Factor Authentication")</h1>
                #parse("esup-otp-error.vm")
                    <form id="fm1" action="$flowExecutionUrl" method="post">
                        #parse("csrf/csrf.vm")
                        <input type="hidden" name="_eventId_proceed">
                    </form>

                <script>
                    var uid = "${uid}"
                    var userHash = "${esupOtpEncoder.getUserHash($uid)}"
                    var apiUrl = "${apiUrl}"
                    var otpManagerUrl = "${environment.getProperty("idp.esup.otp.manager.link")}"

                    getUserOtpMethods_and_displayChoices({ uid, userHash, apiUrl, otpManagerUrl });
                </script>

                #parse("help.vm")

            </section>
        </main>
        #parse("footer.vm")
     </body>
</html>
